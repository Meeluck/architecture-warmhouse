# Этап сборки приложения
# Используем официальный образ Go на Alpine Linux
FROM golang:1.25.6-alpine AS builder

# Рабочая директория внутри контейнера
WORKDIR /app

# Сначала копируем файлы зависимостей отдельно,
# чтобы Docker мог использовать кэш на шаге скачивания модулей
COPY go.mod ./
#COPY go.mod go.sum ./

# Скачиваем зависимости проекта
RUN go mod download

# Копируем остальной исходный код приложения
COPY . .

# Собираем бинарный файл приложения
# Точка в конце означает: собрать пакет из текущей директории
RUN go build -o app .

# Финальный этап: создаём более лёгкий образ только для запуска
FROM alpine:3.22

# Рабочая директория в runtime-контейнере
WORKDIR /app

# Копируем только собранный бинарник из builder-этапа
COPY --from=builder /app/app /app/app

# Документируем порт, который использует приложение
EXPOSE 8081

# Команда запуска контейнера
CMD ["/app/app"]