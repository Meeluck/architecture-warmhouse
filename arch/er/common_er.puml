@startuml
title ER-диаграмма

skinparam linetype ortho
skinparam roundcorner 10

entity "User\n Пользователь системы" as user {
  *id : UUID
  --
  email : string
  password_hash : string
  name : string
  status : string
  created_at : datetime
}

entity "House\n Дом, к которому привязаны устройства" as house {
  *id : UUID
  --
  owner_user_id : UUID <<FK>>
  name : string
  address : string
  created_at : datetime
}

entity "DeviceType\n Тип устройства" as device_type {
  *id : UUID
  --
  name : string
  vendor : string
  model : string
  capabilities_json : json
  created_at : datetime
}

entity "Device\n Конкретное устройство пользователя" as device {
  *id : UUID
  --
  device_type_id : UUID <<FK>>
  house_id : UUID <<FK>>
  name : string
  serial_number : string
  status : string
  online_status : string
  last_seen_at : datetime
  created_at : datetime
}

entity "DeviceOnboarding\n Запись о процессе подключения устройства" as onboarding {
  *id : UUID
  --
  device_id : UUID <<FK>>
  claimed_by_user_id : UUID <<FK>>
  pairing_code : string
  status : string
  claimed_at : datetime
  expires_at : datetime
}

entity "DeviceCredential\n Учётные данные устройства" as credential {
  *id : UUID
  --
  device_id : UUID <<FK>>
  credential_type : string
  credential_ref : string
  status : string
  issued_at : datetime
  revoked_at : datetime
  expires_at : datetime
}

entity "TelemetryData\n Данные телеметрии устройства" as telemetry {
  *id : UUID
  --
  device_id : UUID <<FK>>
  metric_name : string
  metric_value : string
  recorded_at : datetime
}

entity "DeviceEvent\n Событие, возникающее на устройстве" as event {
  *id : UUID
  --
  device_id : UUID <<FK>>
  event_type : string
  payload_json : json
  created_at : datetime
}

entity "Rule\n Пользовательские сценарии" as rule {
  *id : UUID
  --
  house_id : UUID <<FK>>
  created_by_user_id : UUID <<FK>>
  name : string
  status : string
  schedule_expr : string
  created_at : datetime
  updated_at : datetime
}

entity "RuleAction\n Действие внутри сценария" as rule_action {
  *id : UUID
  --
  rule_id : UUID <<FK>>
  device_id : UUID <<FK>>
  action_type : string
  command_name : string
  params_json : json
  execution_order : int
}

entity "RuleExecution\n Факт выполнения сценария" as rule_exec {
  *id : UUID
  --
  rule_id : UUID <<FK>>
  planned_at : datetime
  started_at : datetime
  finished_at : datetime
  status : string
  error_message : string
}

user ||--o{ house : владеет
house ||--o{ device : содержит
device_type ||--o{ device : определяет тип

device ||--o{ onboarding : история подключения
user ||--o{ onboarding : проводит привязку

device ||--o{ credential : имеет учётные данные
device ||--o{ telemetry : генерирует
device ||--o{ event : порождает

house ||--o{ rule : содержит сценарии
user ||--o{ rule : создаёт
rule ||--|{ rule_action : включает
note on link
Сценарий должен содержать
минимум одно действие
end note

device ||--o{ rule_action : цель действия
rule ||--o{ rule_exec : выполнение

@enduml